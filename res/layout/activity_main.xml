<?xml version="1.0" encoding="utf-8"?>
<!-- Phones: everything scrolls as one list. Tablets use layout-sw600dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <include layout="@layout/header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- bottom padding keeps the last footer text clear of the top button -->
        <ListView
            android:id="@+id/app_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="16dp"
            android:paddingBottom="72dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:divider="@color/card_border"
            android:dividerHeight="1dp"
            android:footerDividersEnabled="false"
            android:headerDividersEnabled="false"
            android:descendantFocusability="afterDescendants" />

        <!-- ends above the top button so they don't overlap -->
        <com.flipphoneguy.applock.ScrollBar
            android:id="@+id/scroll_bar"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="84dp" />

        <ImageButton
            android:id="@+id/btn_top"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|right"
            android:layout_margin="16dp"
            android:background="@drawable/btn_round"
            android:src="@drawable/ic_arrow_up"
            android:elevation="6dp"
            android:contentDescription="@string/btn_top"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
